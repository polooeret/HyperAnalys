# Google Vertex AI Configuration
# Path to service account JSON file (relative to project root or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Or pass the JSON inline as a base64 string (alternative for serverless)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# GCP project ID where Vertex AI is enabled
GCP_PROJECT_ID=your-project-id

# GCP region (us-central1, europe-west4, asia-southeast1, etc.)
GCP_LOCATION=us-central1

# Gemini model to use
VERTEX_MODEL=gemini-2.5-pro

# Optional: override default temperature, max tokens
# VERTEX_TEMPERATURE=0.7
# VERTEX_MAX_TOKENS=8192
